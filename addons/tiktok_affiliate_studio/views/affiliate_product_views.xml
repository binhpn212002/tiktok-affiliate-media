<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_affiliate_product_tree" model="ir.ui.view">
        <field name="name">affiliate.product.tree</field>
        <field name="model">affiliate.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="shop_name"/>
                <field name="sku"/>
                <field name="tiktok_product_id"/>
                <field name="channel_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_affiliate_product_form" model="ir.ui.view">
        <field name="name">affiliate.product.form</field>
        <field name="model">affiliate.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="shop_name"/>
                        <field name="sku"/>
                        <field name="tiktok_product_id"/>
                        <field name="product_url" widget="url"/>
                        <field name="channel_ids" widget="many2many_tags"/>
                        <field name="image" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_affiliate_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">affiliate.product</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
