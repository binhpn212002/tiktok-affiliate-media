<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_affiliate_campaign_tree" model="ir.ui.view">
        <field name="name">affiliate.campaign.tree</field>
        <field name="model">affiliate.campaign</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="channel_id"/>
                <field name="campaign_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_affiliate_campaign_form" model="ir.ui.view">
        <field name="name">affiliate.campaign.form</field>
        <field name="model">affiliate.campaign</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="channel_id"/>
                        <field name="campaign_type"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_affiliate_campaign" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">affiliate.campaign</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
