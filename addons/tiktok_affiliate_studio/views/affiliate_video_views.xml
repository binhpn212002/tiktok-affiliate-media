<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_affiliate_video_tree" model="ir.ui.view">
        <field name="name">affiliate.video.tree</field>
        <field name="model">affiliate.video</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="channel_id"/>
                <field name="campaign_id"/>
                <field name="product_id"/>
                <field name="state"/>
                <field name="video_path" widget="url" text="Open video" invisible="not video_path"/>
                <field name="tiktok_draft_status" optional="show"/>
                <button name="action_send_tiktok_draft" type="object" string="Post Video"
                        invisible="state != 'approved' or tiktok_draft_status not in [False, 'failed']"
                        confirm="Send this video to the linked TikTok account's inbox? You can edit and publish it in TikTok."/>
            </tree>
        </field>
    </record>

    <record id="view_affiliate_video_form" model="ir.ui.view">
        <field name="name">affiliate.video.form</field>
        <field name="model">affiliate.video</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_queue_render" type="object" string="Render"
                            class="oe_highlight" invisible="state != 'draft' or render_status == 'queued'"/>
                    <button name="action_send_tiktok_draft" type="object" string="Post Video"
                            invisible="state != 'approved' or tiktok_draft_status not in [False, 'failed']"
                            confirm="Send this video to the linked TikTok account's inbox? You can edit and publish it in TikTok."/>
                    <button name="action_refresh_tiktok_draft" type="object" string="Check TikTok Status"
                            invisible="tiktok_draft_status not in ['processing', 'inbox']"/>
                </header>
                <sheet>
                    <div class="mb-3">
                        <a class="btn btn-secondary" role="button"
                           href="/tiktok_affiliate_studio/static/samples/video-script-template.json"
                           download="video-script-template.json">Download JSON Template</a>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="campaign_id"/>
                        <field name="channel_id"/>
                        <field name="campaign_type"/>
                        <field name="product_id" domain="[('channel_ids', 'in', [channel_id])]" required="campaign_type == 'affiliate'"/>
                        <field name="script_json" readonly="render_status == 'queued'"/>
                        <field name="render_status"/>
                        <field name="render_error" invisible="not render_error"/>
                        <field name="caption"/>
                        <field name="hashtags"/>
                        <field name="video_path" widget="url"/>
                        <field name="state"/>
                    </group>
                    <group string="TikTok Draft" invisible="not tiktok_draft_status">
                        <field name="tiktok_draft_status"/>
                        <field name="tiktok_publish_id"/>
                        <field name="tiktok_draft_checked_at"/>
                        <field name="tiktok_draft_error" invisible="not tiktok_draft_error"/>
                        <div class="text-muted" invisible="tiktok_draft_status != 'inbox'">
                            Open the TikTok inbox notification to edit and publish the video.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_affiliate_video" model="ir.actions.act_window">
        <field name="name">Videos</field>
        <field name="res_model">affiliate.video</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
